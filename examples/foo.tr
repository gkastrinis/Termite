// rec Var(v:Str, ctx:Str)
// decl ancestor(from:Person, to:Person)
// property/relationship equiv-class

decl parent(person:Str, child:Str)

def ancestor(x, y):
    parent(x, y)

def ancestor(x, y), grandparent(x, z, y):
    ancestor(x, z),
    parent (z, y)

